# 大小写不敏感

# 服务器配置
SERVER_PORT=8567
SERVER_HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_passage_creator
DB_USER=root
DB_PASSWORD=123456

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Session 配置
SESSION_SECRET_KEY=your-secret-key-change-in-production
SESSION_MAX_AGE=2592000

# 密码加密盐值
PASSWORD_SALT=yupi

# AI 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=qwen-plus

# Pexels 图片搜索
PEXELS_API_KEY=your-pexels-api-key

# 腾讯云 COS
TENCENT_COS_SECRET_ID=your-cos-secret-id
TENCENT_COS_SECRET_KEY=your-cos-secret-key
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=your-bucket-name
TENCENT_COS_DOMAIN=

# ==================== 配图类 ====================
# Nano Banana / Gemini AI 生图
nano_banana_api_key = your-api-key
NANO_BANANA_MODEL = gemini-2.5-flash-image
NANO_BANANA_ASPECT_RATIO=16:9


# 多智能体并行编排
AGENT_IMAGE_MAX_CONCURRENCY=3
AGENT_IMAGE_FAIL_FAST=true

# ==================== LLM 模型配置 ====================
DEFAULT_LLM_PROVIDER=Xiaomi
DEFAULT_MODEL=mimo-v2.5

# ==================== 信息采集 Agent 配置 ====================
# 说明：以下均带默认值，不显式设置也会按默认值运行（大小写不敏感）

# 主 Agent（搜索规划 + 筛选，较贵、带思考）
INFO_COLLECTOR_MAIN_PROVIDER=Xiaomi
INFO_COLLECTOR_MAIN_MODEL=mimo-v2.5-pro
INFO_COLLECTOR_MAIN_TEMPERATURE=0.0
INFO_COLLECTOR_MAIN_THINKING=true
INFO_COLLECTOR_MAIN_REASONING_EFFORT=high

# 子 Agent（单篇文章摘要，轻量）
INFO_COLLECTOR_SUB_PROVIDER=Xiaomi
INFO_COLLECTOR_SUB_MODEL=mimo-v2.5
INFO_COLLECTOR_SUB_TEMPERATURE=0.0

# 工具调用次数限制（兜底防失控）
INFO_COLLECTOR_SERPER_TOOL_LIMIT=5
INFO_COLLECTOR_EXTRACT_TOOL_LIMIT=10
INFO_COLLECTOR_GLOBAL_TOOL_LIMIT=20
INFO_COLLECTOR_THREAD_LIMIT=40

# 选文 / 返回数量范围
INFO_COLLECTOR_ARTICLE_COUNT_MIN=1
INFO_COLLECTOR_ARTICLE_COUNT_MAX=8
INFO_COLLECTOR_RELEVANT_NEWS_COUNT=5

# 并行与上下文保护
INFO_COLLECTOR_MAX_CONCURRENCY=5
INFO_COLLECTOR_MAX_CONTENT_CHARS=30000
INFO_COLLECTOR_SERPER_NUM=10

# Serper 搜索 API key（信息采集 Agent 用）
SERPER_API_KEY=

# ==================== 文件存储配置 =======================
STATIC_BASE_URL=你的域名