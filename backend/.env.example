# 大小写不敏感

# 服务器配置
# 改端口号需要同步改:
#   1. .env 的 STATIC_BASE_URL
#   2. frontend/vite.config.js 里的代理 target
#   3. frontend/openapi2ts.config.ts 的 schemaPath
SERVER_PORT=8567
SERVER_HOST=0.0.0.0

# 是否信任反向代理传递的 X-Forwarded-For（直连 uvicorn 时保持 False，防止伪造头绕过）
trust_forwarded_headers=false

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_passage_creator
DB_USER=root
DB_PASSWORD=

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Session 配置
SESSION_SECRET_KEY=your-secret-key-change-in-production
SESSION_MAX_AGE=2592000 # 30天

# Pexels 图片搜索（必填）
PEXELS_API_KEY=


# ==================== 文件存储配置 =======================
STATIC_BASE_URL=http://localhost:8567

# 腾讯云 COS（未启用）
tencent_cos_secret_id=a
tencent_cos_secret_key=a
tencent_cos_region=a
tencent_cos_bucket=a
tencent_cos_domain=a


# ==================== 配图类 ====================
# Nano Banana / Gemini AI 生图（可选）
nano_banana_api_key=

# 智谱 AI 生图（可选）
ZHIPU_API_KEY=


# ==================== stripe 支付配置（可选，功能暂未实现） ====================
# ！！！建议使用沙箱秘钥
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success  # 支付成功回调 URL
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel    # 支付取消回调 URL


# ==================== LLM API 配置（必填） =====================
DEEPSEEK_API_KEY=
MIMO_API_KEY=


# ==================== LangSmith 配置（可选，graph、LLM 运行监控） ====================
LANGSMITH_TRACING=true or false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=


# ====================== 信息采集 ========================
SERPER_API_KEY=