# 大小写不敏感

# 服务器配置
SERVER_PORT=8567
SERVER_HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_passage_creator
DB_USER=root
DB_PASSWORD=123456

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Session 配置
SESSION_SECRET_KEY=your-secret-key-change-in-production
SESSION_MAX_AGE=2592000


# ==================== 积分与并发限制（M3：后付费段级结算） ====================
# 积分透支护栏：余额允许为负，最多透支 MAX_DEBT_POINTS（100 积分 = 1 元）
MAX_DEBT_POINTS=100
# 单用户「进行中（含挂起）」创作任务上限（activeTaskCount 原子计数，仅 admin 豁免）
MAX_ACTIVE_TASKS=5
# 僵尸任务判定阈值（小时）：对账/清理识别长时间未完成的任务（本期仅对账计数，不强制清理）
TASK_STALE_HOURS=24

# bcrypt 加密轮数（cost factor），默认 12，可选
# BCRYPT_ROUNDS=12

# AI 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=qwen-plus

# Pexels 图片搜索
PEXELS_API_KEY=your-pexels-api-key

# 腾讯云 COS
TENCENT_COS_SECRET_ID=your-cos-secret-id
TENCENT_COS_SECRET_KEY=your-cos-secret-key
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=your-bucket-name
TENCENT_COS_DOMAIN=

# ==================== 配图类 ====================
# Nano Banana / Gemini AI 生图
nano_banana_api_key = your-api-key
NANO_BANANA_MODEL = gemini-2.5-flash-image
NANO_BANANA_ASPECT_RATIO=16:9

# 智谱 GLM-Image AI 生图（留空则不启用，留空时该配图方式不在创作页暴露）
ZHIPU_API_KEY=
ZHIPU_IMAGE_MODEL=glm-image
ZHIPU_IMAGE_SIZE=1280x1280
# 智谱开放平台生图并发上限为 1，超出会限流失败；此为单服务最大并发
ZHIPU_IMAGE_MAX_CONCURRENCY=1
# 生成接口超时（秒）：AI 生图耗时可能很长 ，过短会 ReadTimeout
ZHIPU_IMAGE_TIMEOUT=120


# ========== SVG 示意图生成 LLM 配置 ==========
# 走 llm_factory 路由，空 provider/model 回退到全局 DEFAULT_LLM_PROVIDER / DEFAULT_MODEL
# 默认 mimo-v2.5-pro（带思考模型更适合 SVG 代码生成）
SVG_DIAGRAM_AGENT_PROVIDER=Xiaomi
SVG_DIAGRAM_AGENT_MODEL=mimo-v2.5-pro
SVG_DIAGRAM_AGENT_TEMPERATURE=0.2
SVG_DIAGRAM_AGENT_THINKING=false
SVG_DIAGRAM_AGENT_REASONING_EFFORT=high

# ==================== 意见反馈每日提交限流 ====================
# 每用户每天最多提交反馈条数（Redis 固定窗口，按北京时间自然日计数；Redis 不可用时拦截）
FEEDBACK_DAILY_LIMIT=10
FEEDBACK_DAILY_WINDOW_SECONDS=86400

# 多智能体并行编排
AGENT_IMAGE_MAX_CONCURRENCY=3
AGENT_IMAGE_FAIL_FAST=true

# ==================== LLM 模型配置 ====================
DEFAULT_LLM_PROVIDER=Xiaomi
DEFAULT_MODEL=mimo-v2.5

# ==================== 信息采集 Agent 配置 ====================
# 说明：以下均带默认值，不显式设置也会按默认值运行（大小写不敏感）

# 主 Agent（搜索规划 + 筛选，较贵、带思考）
INFO_COLLECTOR_MAIN_PROVIDER=Xiaomi
INFO_COLLECTOR_MAIN_MODEL=mimo-v2.5-pro
INFO_COLLECTOR_MAIN_TEMPERATURE=0.0
INFO_COLLECTOR_MAIN_THINKING=true
INFO_COLLECTOR_MAIN_REASONING_EFFORT=high

# 子 Agent（单篇文章摘要，轻量）
INFO_COLLECTOR_SUB_PROVIDER=Xiaomi
INFO_COLLECTOR_SUB_MODEL=mimo-v2.5
INFO_COLLECTOR_SUB_TEMPERATURE=0.0

# 工具调用次数限制（兜底防失控）
INFO_COLLECTOR_SERPER_TOOL_LIMIT=5
INFO_COLLECTOR_EXTRACT_TOOL_LIMIT=10
INFO_COLLECTOR_GLOBAL_TOOL_LIMIT=20
INFO_COLLECTOR_THREAD_LIMIT=40

# 选文 / 返回数量范围
INFO_COLLECTOR_ARTICLE_COUNT_MIN=1
INFO_COLLECTOR_ARTICLE_COUNT_MAX=8
INFO_COLLECTOR_RELEVANT_NEWS_COUNT=5

# 并行与上下文保护
INFO_COLLECTOR_MAX_CONCURRENCY=5
INFO_COLLECTOR_MAX_CONTENT_CHARS=30000
INFO_COLLECTOR_SERPER_NUM=10

# Serper 搜索 API key（信息采集 Agent 用）
SERPER_API_KEY=

# ==================== 文章生成 Agent LLM 配置 ====================
# 说明：以下均带默认值（不显式设置也会按默认值运行）。
# 空字符串 = 使用上方的 DEFAULT_LLM_PROVIDER / DEFAULT_MODEL 作为兜底。

# ---------- 标题生成 Agent ----------
TITLE_AGENT_PROVIDER=
TITLE_AGENT_MODEL=
TITLE_AGENT_TEMPERATURE=0.7
TITLE_AGENT_THINKING=false
TITLE_AGENT_REASONING_EFFORT=high

# ---------- 大纲生成 Agent ----------
OUTLINE_AGENT_PROVIDER=
OUTLINE_AGENT_MODEL=
OUTLINE_AGENT_TEMPERATURE=0.3
OUTLINE_AGENT_THINKING=false
OUTLINE_AGENT_REASONING_EFFORT=high

# ---------- 正文生成 Agent ----------
CONTENT_AGENT_PROVIDER=
CONTENT_AGENT_MODEL=
CONTENT_AGENT_TEMPERATURE=0.7
CONTENT_AGENT_THINKING=false
CONTENT_AGENT_REASONING_EFFORT=high

# ---------- 配图需求分析 Agent ----------
IMAGE_ANALYZER_AGENT_PROVIDER=
IMAGE_ANALYZER_AGENT_MODEL=
IMAGE_ANALYZER_AGENT_TEMPERATURE=0.1
IMAGE_ANALYZER_AGENT_THINKING=false
IMAGE_ANALYZER_AGENT_REASONING_EFFORT=high

# ==================== 文件存储配置 =======================
STATIC_BASE_URL=你的域名