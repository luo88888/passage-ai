# =============================================================================
# passageAI 后端 systemd 服务单元
# 安装方式：
#   sudo cp deploy/passageai-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now passageai-backend
# 查看日志：journalctl -u passageai-backend -f
#
# ⚠️ 关键约束：必须单 worker（不要加 --workers 2+）
#    原因：SSE 进度队列（SseEmitterManager）与 asyncio.create_task 后台任务
#    都是进程内状态，多 worker 会导致「SSE 连到 A 进程、任务跑在 B 进程」，
#    进度流收不到。本项目本身用并发信号量限流，单 worker 足够。
# =============================================================================

[Unit]
Description=PassageAI Backend (FastAPI + uvicorn)
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
# 建议用独立部署用户运行（需对 backend/data、backend/static/images、backend/logs 有写权限）
User=www
Group=www
WorkingDirectory=/www/passage-ai/backend
# 后端启动后从 backend/.env 读取配置（main.py 中 load_dotenv）
Environment=PYTHONUNBUFFERED=1
ExecStart=/www/passage-ai/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8567
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target